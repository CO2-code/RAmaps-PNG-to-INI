{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "devPath": "http://localhost:5173",
    "distDir": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "package": {
    "productName": "RA1 PNG to INI",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {},
    "windows": [
      { "title": "RA1 PNG to INI", "width": 1400, "height": 900 }
    ],
    "security": { "csp": null },
    "bundle": {
      "active": false,
      "identifier": "com.co2code.ramaps-png-to-ini",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/icon.ico"
      ]
    }
  }
}
