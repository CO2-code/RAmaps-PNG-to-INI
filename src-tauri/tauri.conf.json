{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RA1 PNG to INI",
  "version": "0.1.0",
  "identifier": "com.co2code.ramaps-png-to-ini",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "title": "RA1 PNG to INI", "width": 1400, "height": 900 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
